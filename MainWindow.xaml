<Window x:Class="WpfApp5.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Лабораторна робота №3"
        Width="1000"
        Height="700">

    <Grid Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Margin="0,0,0,10">

            <TextBlock Text="h1:"
                       VerticalAlignment="Center"/>

            <TextBox x:Name="H1TextBox"
                     Width="60"
                     Text="1"
                     Margin="5,0,15,0"/>

            <TextBlock Text="h2:"
                       VerticalAlignment="Center"/>

            <TextBox x:Name="H2TextBox"
                     Width="60"
                     Text="0.1"
                     Margin="5,0,15,0"/>

            <Button Content="Побудувати"
                    Command=""
                    Width="100"
                    Click="BuildButton_Click"
                    Margin="0,0,20,0"/>

            <CheckBox x:Name="ReferenceCheckBox"
                      Content="Еталонна"
                      IsChecked="True"
                      Margin="0,0,15,0"
                      Checked="CheckBox_Changed"
                      Unchecked="CheckBox_Changed"/>

            <CheckBox x:Name="LinearCheckBox"
                      Content="Лінійна"
                      IsChecked="True"
                      Margin="0,0,15,0"
                      Checked="CheckBox_Changed"
                      Unchecked="CheckBox_Changed"/>

            <CheckBox x:Name="HermiteCheckBox"
                      Content="Ерміт"
                      IsChecked="True"
                      Checked="CheckBox_Changed"
                      Unchecked="CheckBox_Changed"/>

        </StackPanel>

        <Border Grid.Row="1"
                BorderBrush="Black"
                BorderThickness="1">

            <Canvas x:Name="PlotCanvas"
                    Background="White">

                <Polyline x:Name="ReferencePolyline"
                          Stroke="Blue"
                          StrokeThickness="2"/>

                <Polyline x:Name="LinearPolyline"
                          Stroke="Red"
                          StrokeThickness="2"/>

                <Polyline x:Name="HermitePolyline"
                          Stroke="Green"
                          StrokeThickness="2"/>

            </Canvas>

        </Border>

    </Grid>

</Window>